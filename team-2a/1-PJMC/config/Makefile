.PHONY : src/TripleData.cc.i

src/TripleData.s: src/TripleData.cc.s

.PHONY : src/TripleData.s

# target to generate assembly for a file
src/TripleData.cc.s:
	$(MAKE) -f CMakeFiles/POLARIS3.dir/build.make CMakeFiles/POLARIS3.dir/src/TripleData.cc.s
.PHONY : src/TripleData.cc.s

